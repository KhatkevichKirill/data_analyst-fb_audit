# Read-only analytics database (demo warehouse)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=meta_ads_demo
DB_USER=data_analyst_ro
DB_PASSWORD=data_analyst_ro

# App state database (users, notebooks, cells, events)
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5433
APP_DB_NAME=analyst_app
APP_DB_USER=data_analyst_app
APP_DB_PASSWORD=data_analyst_app

# LLM provider (pick one profile and set its key)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

WEB_MODEL=deepseek
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Local paths
WORKSPACE_ROOT=./workspace
PUBLIC_PLOT_ROOT=./workspace/plots
PUBLIC_PLOT_URL_BASE=/plots

# Optional mount prefix when served behind nginx at /analyst
URL_PREFIX=

# Knowledge base for read_wiki (defaults to package knowledge/)
# KNOWLEDGE_DIR=./data_analyst/knowledge

# python_exec is disabled by default in the starter kit
PYTHON_EXEC_ENABLED=false
# SANDBOX_PYTHON=./.sandbox_venv/bin/python

# Optional model routing (disabled by default)
ROUTING_ENABLED=false
PRIMARY_MODEL_PROFILE=deepseek
ESCALATION_MODEL_PROFILE=openai_gpt41
